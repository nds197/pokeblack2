# linker spec for the ARM7, feed to makelcf.exe with the ARM7-TS template
# object order follows address order, generated by tools/scripts/dump_module.py
#
# ARM7 loads at 0x02380000, entry 0x02380000, 0x28F84 bytes, stored uncompressed
# 0x644 of static, then the autoload payloads, then a 0x20 autoload list the linker writes

Static arm7
{
	Address		0x02380000
	Object		asm/static.o
}

Autoload WRAM
{
	Address		0x037f8000
	Object		asm/wram.o (.text)
	Object		asm/wram.o (.wram)
	Object		asm/wram.o (.bss)
}

Autoload MAIN
{
	Address		0x02fe0000
	Object		asm/main.o (.text)
	Object		asm/main.o (.wram)
	Object		asm/main.o (.bss)
}

Ltdautoload LTDWRAM
{
	Address		0x03000000
	Object		asm/ltdwram.o (.text)
	Object		asm/ltdwram.o (.data)
	Object		asm/ltdwram.o (.ltdwram)
	Object		asm/ltdwram.o (.bss)
}

Ltdautoload LTDMAIN
{
	Address		0x02f88000
	Object		asm/ltdmain.o (.text)
	Object		asm/ltdmain.o (.data)
	Object		asm/ltdmain.o (.ltdwram)
	Object		asm/ltdmain.o (.bss)
}
